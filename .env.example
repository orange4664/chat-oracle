# Chat Oracle Configuration

# Login password
PASSWORD=chat123

# Oracle mode: "remote" or "local"
# remote = connect to Oracle serve via network
# local  = run Oracle browser mode locally (needs Chrome)
ORACLE_MODE=remote

# Remote mode settings (only used when ORACLE_MODE=remote)
ORACLE_REMOTE_HOST=173.254.211.3:3080
ORACLE_REMOTE_TOKEN=your-token-here

# Default GPT Project URL (optional)
# New conversations will be created inside this project
ORACLE_DEFAULT_PROJECT=

# Server port
PORT=3000
